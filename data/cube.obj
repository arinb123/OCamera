# Cube — triangulated, 1x1x1
# 8 vertices, 12 triangles (2 per face)

v -0.5 -0.5 -0.5
v  0.5 -0.5 -0.5
v  0.5  0.5 -0.5
v -0.5  0.5 -0.5
v -0.5 -0.5  0.5
v  0.5 -0.5  0.5
v  0.5  0.5  0.5
v -0.5  0.5  0.5

# Front  (z = +0.5)
f 5 6 7
f 5 7 8
# Back   (z = -0.5)
f 2 1 4
f 2 4 3
# Left   (x = -0.5)
f 1 5 8
f 1 8 4
# Right  (x = +0.5)
f 6 2 3
f 6 3 7
# Bottom (y = -0.5)
f 1 2 6
f 1 6 5
# Top    (y = +0.5)
f 8 7 3
f 8 3 4
